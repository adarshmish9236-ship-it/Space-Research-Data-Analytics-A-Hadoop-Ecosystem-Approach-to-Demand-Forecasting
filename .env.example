# ======================================================
# ORBITALYTICS — Environment Configuration
# Copy this to .env and adjust values for your environment
# ======================================================

# Application
APP_NAME=ORBITALYTICS
APP_ENV=development
APP_VERSION=1.0.0
DEBUG=true

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Data Paths (local filesystem mirrors HDFS structure)
DATA_BASE_PATH=../data
RAW_DATA_PATH=../data/raw
PROCESSED_DATA_PATH=../data/processed
ANALYTICS_DATA_PATH=../data/analytics
MODELS_PATH=../models/saved

# Hadoop / HDFS (for real cluster deployment)
HDFS_NAMENODE_HOST=localhost
HDFS_NAMENODE_PORT=9000
HDFS_BASE_PATH=/space
USE_REAL_HDFS=false

# Hive (for real cluster deployment)
HIVE_HOST=localhost
HIVE_PORT=10000
HIVE_DATABASE=space_analytics
USE_REAL_HIVE=false

# Spark
SPARK_MASTER=local[*]
SPARK_APP_NAME=ORBITALYTICS
SPARK_LOG_LEVEL=WARN
SPARK_DRIVER_MEMORY=4g
SPARK_EXECUTOR_MEMORY=4g

# Kafka (optional streaming)
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_SPACE_EVENTS=space_events
KAFKA_CONSUMER_GROUP=orbitalytics

# ML Settings
MODEL_AUTO_SELECT=true
FORECAST_CONFIDENCE_FACTOR=1.5
MAX_FORECAST_YEARS=5

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Data Generator
DEFAULT_DATA_SCALE=100000
RANDOM_SEED=42
